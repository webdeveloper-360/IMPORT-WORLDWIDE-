# Paystack (Dashboard > Settings > API Keys). Use the sk_test_ key while testing.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Must match the currency enabled on your Paystack account (GHS for Ghana).
NEXT_PUBLIC_CURRENCY=GHS
# Admin login. Use a long random password, and a separate random string for the session secret.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Upstash Redis (Vercel > Storage > Marketplace > Upstash Redis). Vercel adds these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
